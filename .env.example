# ─────────────────────────────────────────
# Supabase (obrigatório)
# ─────────────────────────────────────────
VITE_SUPABASE_URL=<url-do-projeto-supabase>
VITE_SUPABASE_ANON_KEY=<chave-anonima-supabase>

# Conexão direta ao PostgreSQL (uso server-side / migrations)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-us-west-2.pooler.supabase.com:6543/postgres

# ─────────────────────────────────────────
# GitHub (opcional — usado para sincronização com repositório)
# ─────────────────────────────────────────
GITHUB_TOKEN=<token-github-com-permissao-repo>

# ─────────────────────────────────────────
# Mastra AI Agent — agentes de IA locais em :4111
# O servidor Mastra lê este arquivo via --env ../.env
# ─────────────────────────────────────────
VITE_MASTRA_URL=http://localhost:4111

# Necessária para os agentes Mastra funcionarem
OPENAI_API_KEY=<sua-chave-openai>
