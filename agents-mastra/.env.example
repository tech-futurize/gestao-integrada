# ─────────────────────────────────────────
# OpenAI — modelo dos agentes
# ─────────────────────────────────────────
OPENAI_API_KEY=<sua-chave-openai>

# ─────────────────────────────────────────
# PostgreSQL — conexão direta ao Supabase
# Deve ser a mesma DATABASE_URL do .env raiz.
# O servidor Mastra é iniciado com: npm run dev
# que carrega ../.env automaticamente via --env ../.env
# Não é necessário criar um .env aqui — copie o .env.example da raiz.
# ─────────────────────────────────────────
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ─────────────────────────────────────────
# Supabase — para carregar agentes do banco dinamicamente
# SUPABASE_URL: URL do projeto (https://<ref>.supabase.co)
# SUPABASE_SERVICE_KEY: service_role key (não expor ao browser)
# ─────────────────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>   # OBRIGATÓRIO — use a service_role key (não a anon key)

# ─────────────────────────────────────────
# Anthropic — necessário se usar modelos Claude
# ─────────────────────────────────────────
# ANTHROPIC_API_KEY=<sua-chave-anthropic>
